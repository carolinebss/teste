    "AMPLITUDES = np.arange(0., 21., 1.)\n",
    "RESULTADOS, MINIMOS, linhas = {}, {}, []\n",
    "for chave in CONDICOES:\n",
    "    sucessos = []\n",
    "    for amp in AMPLITUDES:\n",
    "        r = simular(chave, amp)\n",
    "        RESULTADOS[(chave, float(amp))] = r\n",
    "        if np.any(r['picos'] >= r['inicio']):\n",
    "            sucessos.append(float(amp))\n",
    "    MINIMOS[chave] = min(sucessos) if sucessos else np.nan\n",
    "    linhas.append({'Condição': chave, 'Descrição': CONDICOES[chave]['nome'],\n",
    "                   'Menor corrente (µA/cm²)': MINIMOS[chave],\n",
    "                   'Observação': 'Disparo com I=0' if 0. in sucessos else\n",
    "                                  ('Nenhum disparo na faixa' if not sucessos else 'Disparo detectado')})\n",
    "tabela = pd.DataFrame(linhas)\n",
    "display(tabela)"
