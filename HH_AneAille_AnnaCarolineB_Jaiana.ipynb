    "def razao_estavel(z):\n",
    "    # Limite z/(1-exp(-z)) = 1 em z=0; evita 0/0 nas taxas.\n",
    "    return 1 + z/2 + z*z/12 if abs(z) < 1e-6 else z / (-np.expm1(-z))\n",
    "\n",
    "def taxas(V, shift=0.):\n",
    "    U = V + shift\n",
    "    am = razao_estavel((U + 40)/10)\n",
    "    bm = 4*np.exp(-(U + 65)/18)\n",
    "    ah = .07*np.exp(-(V + 65)/20)\n",
    "    bh = 1/(1 + np.exp(-(V + 35)/10))\n",
    "    an = .1*razao_estavel((V + 55)/10)\n",
    "    bn = .125*np.exp(-(V + 65)/80)\n",
    "    return np.array([am, ah, an]), np.array([bm, bh, bn])\n",
    "\n",
    "def correntes(y, p):\n",
    "    V, m, h, n = y\n",
    "    return p['gNa']*m**3*h*(V-ENa), gK*n**4*(V-EK), gL*(V-EL)\n",
    "\n",
    "def rhs(t, y, corrente, p):\n",
    "    V, m, h, n = y\n",
    "    a, b = taxas(V, p['shift'])\n",
    "    comportas = np.array([m, h, n])\n",
    "    ina, ik, il = correntes(y, p)\n",
    "    return np.r_[(corrente-ina-ik-il)/Cm, a*(1-comportas)-b*comportas]\n",
    "\n",
    "def segmento(y0, duracao, corrente, p, dt=DT):\n",
    "    grade = np.linspace(0, duracao, int(np.ceil(duracao/dt))+1)\n",
    "    sol = solve_ivp(rhs, (0, duracao), y0, args=(corrente, p),\n",
    "                    t_eval=grade, rtol=1e-7, atol=1e-9, max_step=.1)\n",
    "    if not sol.success:\n",
    "        raise RuntimeError(sol.message)\n",
    "    return sol.t, sol.y\n",
    "\n",
    "def picos(t, V):\n",
    "    # Detector de eventos, NÃO regra de geração/reset do HH.\n",
    "    j = np.where((V[:-1] < 0) & (V[1:] >= 0))[0]\n",
    "    return t[j] + (0-V[j])*(t[j+1]-t[j])/(V[j+1]-V[j])\n",
    "\n",
    "ESTADOS, DIAGNOSTICO = {}, []\n",
    "for chave, p in CONDICOES.items():\n",
    "    a, b = taxas(-65., p['shift'])\n",
    "    t, y = segmento(np.r_[-65., a/(a+b)], 500., 0., p)\n",
    "    ultimos = t >= 400\n",
    "    espontaneo = len(picos(t[ultimos], y[0, ultimos])) > 0\n",
    "    variacao = np.ptp(y[0, ultimos])\n",
    "    ESTADOS[chave] = y[:, -1].copy()\n",
    "    DIAGNOSTICO.append({'Condição': chave, 'V final (mV)': y[0,-1],\n",
    "                        'Amplitude final (mV)': variacao,\n",
    "                        'Disparo sem estímulo': espontaneo})\n",
    "    if espontaneo or variacao > .1:\n",
    "        print(f'ATENÇÃO {chave}: sem repouso estável; interpretar estado inicial antes de continuar.')\n",
    "display(pd.DataFrame(DIAGNOSTICO).round(5))\n",
    "\n",
    "def simular(chave, amplitude, duracao=5., dt=DT):\n",
    "    p = CONDICOES[chave]\n",
    "    y0 = ESTADOS[chave].copy()  # reinicializa TODOS os testes\n",
    "    ts, ys, offset = [], [], 0.\n",
    "    for k, (d, I) in enumerate([(10., 0.), (duracao, amplitude), (30., 0.)]):\n",
    "        t, y = segmento(y0, d, I, p, dt)\n",
    "        ts.append(t[k>0:] + offset)\n",
    "        ys.append(y[:, k>0:])\n",
    "        y0, offset = y[:, -1], offset+d\n",
    "    t, y = np.concatenate(ts), np.concatenate(ys, axis=1)\n",
    "    return {'t': t, 'y': y, 'picos': picos(t, y[0]),\n",
    "            'INa': correntes(y, p)[0], 'inicio': 10., 'fim': 10.+duracao}"
   ]
