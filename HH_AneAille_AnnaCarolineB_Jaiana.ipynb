    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.integrate import solve_ivp\n",
    "from IPython.display import display\n",
    "\n",
    "plt.rcParams.update({'figure.figsize': (10, 4), 'font.size': 11})\n",
    "CORES = {'A': '#183153', 'B': '#db6b24', 'C': '#008c95'}\n",
    "CONDICOES = {\n",
    "    'A': {'nome': 'Referência', 'shift': 0., 'gNa': 120.},\n",
    "    'B': {'nome': 'Ativação facilitada', 'shift': 1., 'gNa': 120.},\n",
    "    'C': {'nome': 'Condutância reduzida', 'shift': 1., 'gNa': 90.},\n",
    "}\n",
    "Cm, gK, gL = 1., 36., 0.3\n",
    "ENa, EK, EL = 50., -77., -54.387\n",
    "DT = 0.05"
   ]
